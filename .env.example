APP_NAME=Catatku
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker: the app container reaches MySQL through the compose network alias "db".
# GUI clients on the host connect to 127.0.0.1 port 3307 instead.
# Production has no database container: set DB_HOST to the database server's
# address there. DB_ROOT_PASSWORD is only meaningful for this compose stack.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=catatku
DB_USERNAME=catatku
DB_PASSWORD=catatku
DB_ROOT_PASSWORD=catatku-root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true on the server: the tunnel terminates TLS before the container.
SESSION_SECURE_COOKIE=false

# Host port published by docker-compose.production.yml; the tunnel forwards to it.
APP_PORT=8080

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="halo@catatku.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
